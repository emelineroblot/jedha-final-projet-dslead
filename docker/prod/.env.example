# Copier en docker/prod/.env sur le serveur (jamais versionné).
POSTGRES_USER=churnguard
POSTGRES_PASSWORD=change-me
AIRFLOW_USER=airflow
AIRFLOW_PASSWORD=change-me
AIRFLOW_SECRET_KEY=change-me-long-random-string

# Images construites par la CI (GitHub Actions → GHCR)
API_IMAGE=ghcr.io/emelineroblot/churnguard-api:main
MLFLOW_IMAGE=ghcr.io/emelineroblot/churnguard-mlflow:main
AIRFLOW_IMAGE=ghcr.io/emelineroblot/churnguard-airflow:main
API_WORKERS=2

# Dossier du dépôt cloné sur le serveur (src/ et data/ montés dans Airflow)
CHURNGUARD_HOME=/opt/churnguard

# Webhook Discord ou Slack pour les alertes (optionnel)
ALERT_WEBHOOK_URL=
