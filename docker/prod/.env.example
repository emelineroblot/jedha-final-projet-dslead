# Copier en docker/prod/.env sur le serveur (jamais versionné). Sur AWS, ce fichier est généré par
# infra/terraform/user_data.sh avec des secrets aléatoires.
POSTGRES_USER=churnguard
POSTGRES_PASSWORD=change-me
AIRFLOW_USER=airflow
AIRFLOW_PASSWORD=change-me
AIRFLOW_SECRET_KEY=change-me-long-random-string

# Images : construites sur l'instance (`compose build`) ou tirées de GHCR (`compose pull`) — même tag
API_IMAGE=ghcr.io/emelineroblot/churnguard-api:main
MLFLOW_IMAGE=ghcr.io/emelineroblot/churnguard-mlflow:main
AIRFLOW_IMAGE=ghcr.io/emelineroblot/churnguard-airflow:main
DASHBOARD_IMAGE=ghcr.io/emelineroblot/churnguard-dashboard:main
API_WORKERS=1

# Dossier du dépôt cloné sur le serveur (src/ et data/ montés dans Airflow)
CHURNGUARD_HOME=/opt/churnguard

# Webhook Discord ou Slack pour les alertes (optionnel)
ALERT_WEBHOOK_URL=

# Artefacts MLflow : volume Docker par défaut ; sur AWS, S3 via le rôle d'instance (endpoint régional obligatoire)
MLFLOW_ARTIFACTS_DESTINATION=/mlruns
MLFLOW_S3_ENDPOINT_URL=
AWS_DEFAULT_REGION=
